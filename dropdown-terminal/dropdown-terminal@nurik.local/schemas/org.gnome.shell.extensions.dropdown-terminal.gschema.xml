<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.dropdown-terminal"
          path="/org/gnome/shell/extensions/dropdown-terminal/">

    <key name="toggle" type="as">
      <default><![CDATA[['<Super>Return']]]></default>
      <summary>Show or hide the terminal</summary>
    </key>

    <key name="session" type="s">
      <choices>
        <choice value="plain"/>
        <choice value="tmux"/>
      </choices>
      <default>'tmux'</default>
      <summary>What runs in the terminal</summary>
      <description>'plain': your shell, gone when the terminal closes. 'tmux': a tmux session that outlives the window.</description>
    </key>

    <key name="width" type="u">
      <default>70</default>
      <range min="20" max="100"/>
      <summary>Width, percent of the work area</summary>
    </key>
    <key name="height" type="u">
      <default>45</default>
      <range min="15" max="100"/>
      <summary>Height, percent of the work area</summary>
    </key>
    <key name="opacity" type="u">
      <default>95</default>
      <range min="50" max="100"/>
      <summary>Background opacity, percent</summary>
    </key>

    <key name="hide-on-unfocus" type="b">
      <default>false</default>
      <summary>Hide the terminal when another window gets the focus</summary>
    </key>
  </schema>
</schemalist>
